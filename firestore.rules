rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if user is a teacher (by reading the user's role from their document)
    // Note: This requires a read, which costs a read operation. Alternatively, we could use Custom Claims.
    function isTeacher() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users Collection
    match /users/{userId} {
      // Anyone can read (needed for leaderboards/dashboards)
      allow read: if isAuthenticated();
      // Users can only create/update their own document, admins can do anything
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Classes Collection
    match /classes/{classId} {
      allow read: if isAuthenticated();
      // Only teachers can create or modify classes
      allow write: if isAuthenticated() && isTeacher();
    }

    // Quiz Results Collection
    match /quiz_results/{resultId} {
      // Any authenticated user can read or write (could be tightened later to only allow students to write their own and teachers to read all)
      allow read, write: if isAuthenticated();
    }

    // Study Sessions Collection
    match /study_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacher();
    }

    // Classroom Messages
    match /classroom_messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
